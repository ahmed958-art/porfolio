import { isPlatformBrowser } from '@angular/common';
import { gsap } from 'gsap';
import { ImageTrail } from '../shared/image-trail/image-trail';
import { ThreeDHoverGallery, GalleryImage } from '../shared/three-d-hover-gallery/three-d-hover-gallery';

// NOTE: Zero querySelector / getElementById / querySelectorAll on the component.
// All element access goes through Angular viewChild / nativeElement.

@Component({
  selector: 'app-home',
  standalone: true,
  imports: [ImageTrail, ThreeDHoverGallery],
  templateUrl: './home.html',
  styleUrl: './home.scss',
})
export class Home implements AfterViewInit, OnDestroy {
  private platformId = inject(PLATFORM_ID);
  private zone = inject(NgZone);

  // ── Template refs ─────────────────────────────────────────────────────────
  slide0    = viewChild.required<ElementRef<HTMLElement>>('slide0');
  slide1    = viewChild.required<ElementRef<HTMLElement>>('slide1');
  slide2    = viewChild.required<ElementRef<HTMLElement>>('slide2');
  slide3    = viewChild.required<ElementRef<HTMLElement>>('slide3');
  cursorEl  = viewChild.required<ElementRef<HTMLElement>>('cursor');
  cursorDot = viewChild.required<ElementRef<HTMLElement>>('cursorDot');
  hoverZone = viewChild.required<ElementRef<HTMLElement>>('hoverZone');

  // ── State ──────────────────────────────────────────────────────────────────
  currentSlide = signal(0);
  readonly totalSlides = 4;
  isAnimating = false;

  slides = [{ index: 0 }, { index: 1 }, { index: 2 }, { index: 3 }];

  // ── Gallery images for slide 0 ────────────────────────────────────────────
  galleryImages: GalleryImage[] = [
    { src: 'ecommerce_dark_neon_landing_page.jpg', alt: 'E-commerce project' },
    { src: 'roi_calculator_landing_page.jpg',      alt: 'ROI Calculator' },
    { src: 'chatting.png',                         alt: 'Chat app' },
    { src: 'fitnedd.png',                          alt: 'Fitness app' },
    { src: 'charlesdeluvio-tcwNN4B9uWE-unsplash.jpg',            alt: 'Project 5' },
  ];



  // ── Stored handler refs (needed for removeEventListener) ──────────────────
  private wheelHandler!: (e: WheelEvent) => void;
  private mouseMoveHandler!: (e: MouseEvent) => void;
  private touchStartHandler!: (e: TouchEvent) => void;
  private touchEndHandler!: (e: TouchEvent) => void;
  private touchStartY = 0;

  // ── Typed helper — returns slide native elements in order ─────────────────
  private get slideEls(): HTMLElement[] {
    return [
      this.slide0().nativeElement,
      this.slide1().nativeElement,
      this.slide2().nativeElement,
      this.slide3().nativeElement,
    ];
  }

  ngAfterViewInit(): void {
    if (!isPlatformBrowser(this.platformId)) return;

    this.zone.runOutsideAngular(() => {
      // ── Intro animation for slide 0 ───────────────────────────────────────
      const s0 = this.slide0().nativeElement;

      gsap.timeline({ defaults: { ease: 'power3.out' } })
        .from(s0.querySelectorAll('.title-word'),    { y: 120, opacity: 0, stagger: 0.08, duration: 1, delay: 0.2 })
        .from(s0.querySelector('.meta-left'),        { y: 20, opacity: 0, duration: 0.6 }, '-=0.4')
        .from(s0.querySelector('.meta-right'),       { y: 20, opacity: 0, duration: 0.6 }, '-=0.5')
        .from(s0.querySelector('.slide-indicator'),  { opacity: 0, duration: 0.4 },        '-=0.2');

      // ── Wheel ─────────────────────────────────────────────────────────────
      this.wheelHandler = (e: WheelEvent) => {
        e.preventDefault();
        if (this.isAnimating) return;
        this.zone.run(() => this.goTo(this.currentSlide() + (e.deltaY > 0 ? 1 : -1)));
      };

      // ── Touch ─────────────────────────────────────────────────────────────
      this.touchStartHandler = (e: TouchEvent) => {
        this.touchStartY = e.touches[0].clientY;
      };
      this.touchEndHandler = (e: TouchEvent) => {
        const delta = this.touchStartY - e.changedTouches[0].clientY;
        if (Math.abs(delta) < 50) return;
        this.zone.run(() => this.goTo(this.currentSlide() + (delta > 0 ? 1 : -1)));
      };

      // ── Custom cursor ─────────────────────────────────────────────────────
      const cursor    = this.cursorEl().nativeElement;
      const cursorDot = this.cursorDot().nativeElement;

      this.mouseMoveHandler = (e: MouseEvent) => {
        gsap.to(cursor,    { x: e.clientX, y: e.clientY, duration: 0.55, ease: 'power2.out' });
        gsap.to(cursorDot, { x: e.clientX, y: e.clientY, duration: 0.1,  ease: 'none' });
      };

      // Event delegation on the hoverZone instead of looping every button
      const hz = this.hoverZone().nativeElement;
      hz.addEventListener('mouseenter', (e: Event) => {
        if ((e.target as Element).closest('button, a, .work-grid-item, .about-grid-item'))
          gsap.to(cursor, { scale: 1.8, duration: 0.3 });
      }, true);
      hz.addEventListener('mouseleave', (e: Event) => {
        if ((e.target as Element).closest('button, a, .work-grid-item, .about-grid-item'))
          gsap.to(cursor, { scale: 1, duration: 0.3 });
      }, true);

      window.addEventListener('wheel',      this.wheelHandler,      { passive: false });
      window.addEventListener('touchstart', this.touchStartHandler, { passive: true });
      window.addEventListener('touchend',   this.touchEndHandler,   { passive: true });
      window.addEventListener('mousemove',  this.mouseMoveHandler);
    });
  }

  goTo(index: number): void {
    if (index < 0 || index >= this.totalSlides || this.isAnimating) return;
    this.isAnimating = true;

    const prev   = this.currentSlide();
    const dir    = index > prev ? 1 : -1;
    const slides = this.slideEls;
    const prevEl = slides[prev];
    const nextEl = slides[index];

    gsap.set(nextEl, { yPercent: dir * 100, display: 'flex', opacity: 1 });

    gsap.timeline({
      onComplete: () => {
        gsap.set(prevEl, { display: 'none' });
        this.zone.run(() => {
          this.currentSlide.set(index);
          this.isAnimating = false;
        });
      },
    })
      .to(prevEl, { yPercent: -dir * 30, opacity: 0, duration: 0.9, ease: 'power3.inOut' })
      .to(nextEl, { yPercent: 0, duration: 1, ease: 'power3.inOut' }, '-=0.7')
      .from(
        nextEl.querySelectorAll(
          '.title-word, .meta-left, .meta-right, .slide-eyebrow, .cta-btn, .work-grid-item, .about-grid-item, .intro-name, .intro-text, .intro-cta, .logos-label, .logo-card'
        ),
        { y: 40, opacity: 0, stagger: 0.06, duration: 0.7, ease: 'power3.out' },
        '-=0.5'
      );
  }

  ngOnDestroy(): void {
    if (!isPlatformBrowser(this.platformId)) return;
    window.removeEventListener('wheel',      this.wheelHandler);
    window.removeEventListener('touchstart', this.touchStartHandler);
    window.removeEventListener('touchend',   this.touchEndHandler);
    window.removeEventListener('mousemove',  this.mouseMoveHandler);
    gsap.killTweensOf('*');
  }
}
